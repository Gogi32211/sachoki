{
  "name": "tz-signal-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run typecheck:negative && npm run test:decode && vite build",
    "preview": "vite preview --port 8080",
    "typecheck": "tsc -p tsconfig.studio.json",
    "typecheck:negative": "tsc -p tsconfig.typetests.json",
    "test:decode": "tsc -p tsconfig.decodetests.json && node .decodetests/studio/__tests__/ranking_provenance.js"
  },
  "dependencies": {
    "date-fns": "^4.3.0",
    "lightweight-charts": "^4.1.6",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "5.6",
    "vite": "^5.3.1"
  }
}
