  "AUDIT_1_G_STAR_INCOMING_STATE": {
    "recurrence": "g1_raw = g_armed AND s==T1 ; any_g = OR(g*_raw) ; g_armed := (g_armed OR trigger_z) AND NOT any_g",
    "OUTPUT_vs_NEXT_STATE_ARE_DISTINCT": "the output at bar i uses the INCOMING state; the next-state resolves after the bar. They must not be conflated or an off-by-one validity bug appears.",
    "sealed_rule": {
      "s NOT in firing set {T1,T1G,T4,T6}": "output trivially False -> AVAILABLE_VALID (no state needed)",
      "s in firing set, incoming state KNOWN": "AVAILABLE_VALID",
      "s in firing set, incoming state UNKNOWN": "INITIALIZATION_SENSITIVE",
      "after s in {Z10,Z11,Z12}": "next-state TRUE (determined)",
      "after s in firing set": "next-state FALSE (determined, since g_armed AND NOT g_armed = False)",
      "otherwise": "next-state carries prior"
    },
    "implementation": "known[first_determining_index + 1:] — the determining bar itself is excluded from known, which is the off-by-one guard",
    "CORRECTION_OF_MY_EARLIER_RULE": {
      "wrong": "\"VALID only from the first arming trigger (Z10/Z11/Z12)\"",
      "why_wrong": "a firing-set bar also determines the state (to False), and separately every non-firing bar has a trivially-False output needing no state at all",
      "measured_impact": "pilot on 5 heterogeneous securities: valid bars 436->9,013 · 1,017->15,974 · 326->4,460 · 6->457 · 6,122->13,690. The old rule suppressed roughly 95% of genuine support.",
      "corroboration": "g* now shows a HIGHER valid share (63.85%) than the hard-dependency features (61.40%), which is the expected signature: g* needs no prior bar, the Z family does"
    }
  },
  "AUDIT_2_PARTIAL_WINDOW": {
    "source_check": {
      "compute_tz_state": "rolling(3, min_periods=1), rolling(7, min_periods=1)",
      "compute_vabs": "rolling(20, min_periods=1), rolling(20, min_periods=2), rolling(5, min_periods=1)"
    },
    "conclusion": "min_periods IS reduced, so partial windows DO produce values. These bars are \"value exists but may differ from full-history replay\" = INITIALIZATION_SENSITIVE, NOT UNAVAILABLE_HISTORY.",
    "note": "the caller hypothesised UNAVAILABLE_HISTORY here; the source does not support it. Recorded because the distinction changes what the census means.",
    "vbo_up_first_bar": "min_periods=2 makes the segment-first bar genuinely unavailable",
    "depths": {
      "sig_tz_flip": 9,
      "vbo_up": 20
    }
  },
  "AUDIT_3_VALUE_STATE_CONSISTENCY": {
    "guard_1": "AVAILABLE_VALID => value MUST be non-null",
    "guard_2": "availability != AVAILABLE_VALID => evaluation layer MUST ignore the value entirely",
    "guard_3": "a missing value on an INIT_SENSITIVE bar must NEVER be coerced to False/0 — NULL and FALSE are different facts for boolean features",
    "verification": {
      "valid_bars_checked": 118813,
      "violations": 0,
      "result": "CONFIRMED"
    },
    "proof_by_construction": "AVAILABLE_VALID requires age>=depth; age>=depth implies the containing COMPLETE run is at least depth long; the engine is invoked on exactly those runs. Hence the segment-length gate can never skip a VALID bar.",
    "DECLARED_LIMITATION": "on segments shorter than a feature depth the VALUE is not materialised at all. Those bars are correctly classed INIT_SENSITIVE, but their values are absent rather than computed-and-discarded. This is acceptable ONLY because availability is the sole authoritative gate."
  },
