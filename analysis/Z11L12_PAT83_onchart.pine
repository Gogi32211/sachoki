// ── flagship Z11(os) → T3/T5 → T11/T12 ──────────────────────────────────────────
isZ11os  = (bearCode == 10) and osBandP
isConfP  = (bullCode == 9) or (bullCode == 11)
isResolP = flagT12 ? (bullCode == 12) : ((bullCode == 10) or (bullCode == 12))
flagHit  = showFlag and isResolP and isConfP[1] and isZ11os[2]
bgcolor(flagHit ? color.new(color.lime, 75) : na, title="★ Flagship entry bar")
if flagHit
    string _conf = bullCode[1] == 9 ? "T3" : "T5"
    string _res  = bullCode == 10 ? "T11" : "T12"
    label.new(bar_index, high + atr * 0.6, "🪤 Z11→" + _conf + "→" + _res + "\nRSI " + str.tostring(rsi14p[2], "#"),
         xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down,
         size=size.small, color=color.new(color.lime, 0), textcolor=color.black)
alertcondition(flagHit, "Z11 flagship reversal", "Z11(os)->T3/T5->T11/T12 entry")
